{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@constra/core": ["packages/core/src/index.ts"],
      "@constra/stdlib": ["packages/stdlib/src/index.ts"],
      "@constra/solver-backtracking": ["packages/solver-backtracking/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "examples/**/*"
  ]
}
