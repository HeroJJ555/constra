{
    "compilerOptions": {
        "outDir": "dist",
        "declaration": true,
        "module": "ESNext",
        "target": "ES2020",
        "moduleResolution": "Bundler",
        "strict": true,
        "paths": {
            "@constra/core": [
                "./packages/core/src/index.ts"
            ],
            "@constra/stdlib": [
                "./packages/stdlib/src/index.ts"
            ],
            "@constra/solver-backtracking": [
                "./packages/solver-backtracking/src/index.ts"
            ]
        }
    },
    "include": [
        "packages/*/src/**/*",
        "examples/**/*"
    ],
    "exclude": [
        "dist",
        "node_modules",
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/__tests__/**",
        "examples"
    ]
}