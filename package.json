{
  "name": "@herojj555/constra",
  "version": "0.2.0",
  "description": "TypeScript constraint solver for scheduling and allocation problems.",
  "license": "Mozilla Public License Version 2.0",
  "type": "module",
  "private": false,
  "main": "./dist/core/src/index.js",
  "types": "./dist/core/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/core/src/index.js",
      "types": "./dist/core/src/index.d.ts"
    },
    "./stdlib": {
      "import": "./dist/stdlib/src/index.js",
      "types": "./dist/stdlib/src/index.d.ts"
    },
    "./solver-backtracking": {
      "import": "./dist/solver-backtracking/src/index.js",
      "types": "./dist/solver-backtracking/src/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx examples/basic.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.4"
  }
}
